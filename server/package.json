{
  "name": "ServerWatch",
  "version": "0.1.0",
  "private": true,
  "bin": "bundle.cjs",
  "scripts": {
    "bundle": "esbuild app.js --bundle --platform=node --target=node18 --outfile=bundle.cjs",
    "start": "node app",
    "dev": "./node_modules/.bin/nodemon app",
    "build:linux": "npm run bundle && pkg bundle.cjs -t node18-linux-x64 -o serverwatch-linux --public",
    "build:linux-arm64": "npm run bundle && pkg bundle.cjs -t node18-linux-arm64 --no-bytecode -o serverwatch-linux-arm64 --public",
    "build:win": "npm run bundle && pkg bundle.cjs -t node18-win-x64 -o serverwatch-win-x64.exe --public",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@koa/cors": "^2.2.1",
    "jsonwebtoken": "^8.1.0",
    "koa": "^2.2.0",
    "koa-bodyparser": "^3.2.0",
    "koa-json": "^2.0.2",
    "koa-logger": "^3.1.0",
    "koa-onerror": "^1.2.1",
    "koa-router": "^7.1.1",
    "koa-session-minimal": "^3.0.4",
    "koa-static": "^3.0.0",
    "nodemailer": "^9.1.0",
    "shortid": "^2.2.8",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "nodemon": "^1.8.1"
  },
  "pkg": {
    "assets": [
      "./static/**/*",
      "./shell/*"
    ]
  }
}
